<div class="content-body"></div>
<div class="col-lg-12">
  <div class="card">
    <div class="card-body">
      <h1 class="text-center">Doctor Detail</h1>
    </div>  
  </div>

  <div class="p-4">
    <p class="lead"><strong>ID:</strong> <%= @doctor.id %></p>
    <p class="lead"><strong>Name:</strong> <%= @doctor.Name %></p>
    <p class="lead"><strong>Email:</strong> <%= @Email%></p>
    <p class="lead"><strong>Contact No:</strong> <%= @doctor.ContactNo %></p>
    <p class="lead"><strong>Specialization:</strong> <%= @doctor.Specialization %></p>
    <p class="lead"><strong>Address:</strong> <%= @doctor.Address %></p>
    <p class="lead"><strong>Experience:</strong> <%= @doctor.experience_year %></p>
  </div>

  <div class="mt-4">
    <%= link_to 'Back to Doctors', doctors_path, class: 'btn btn-primary btn-lg' %>
    <%= link_to 'Edit Token', edit_doctor_path(@doctor), class: 'btn btn-info btn-lg' %>
  </div>
</div>
<style type="text/css">
     .content-body {
        margin-left:900px;
    }
</style>

