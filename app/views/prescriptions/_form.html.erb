<%= form_for [@token, @prescription] do |f| %>
  <div>
    <%= f.label :name %>
    <%= f.text_field :name %>
  </div>

  <div>
    <%= f.label :category %>
    <%= f.text_field :category %>
  </div>

  <div>
    <%= f.label :formula %>
    <%= f.text_field :formula %>
  </div>

  <h3>Medicines</h3>
  <div id="medicines">
    <%= f.fields_for :medicines do |medicine_form| %>
      <%= render 'medicine_fields', f: medicine_form %>
    <% end %>

    <%= link_to_add_association 'Add Medicine', f, :medicines, partial: 'medicine_fields', data: { turbo: false } %>
  </div>

  <div>
    <%= f.submit 'Create Prescription' %>
  </div>
<% end %>
