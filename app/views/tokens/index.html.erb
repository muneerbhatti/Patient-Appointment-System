<div class="content-body">
  <div class="col-lg-12">
    <div class="card">
      <div class="card-body">
        <h1 class="text-center">Token Infermation</h1>
      </div>
      <p class="notice"><%= notice %></p>
    </div>
    <div class="col-lg-4 search_bar">
      <%= form_with(url: tokens_path, method: :get, local: true, class: 'search-form') do |form| %>
        <div class="input-group ">
          <%= form.text_field :search, placeholder: "search Token", class: 'form-control' %>
          <span class="input-group-btn">
            <%= form.submit "search", class: 'btn btn-primary' %>
          </span>
        </div>
      <% end %>
    </div>
    <% if current_user.userable_type == "Reception" || current_user.userable_type == "Patient" ||
      current_user.userable_type == "Admin" %>
      <div class="abc">
        <%= link_to 'New token', new_token_path, class: 'btn btn-primary btn-lg' %>
      </div>
    <% end %>
  </div>
<table id="tokens-table" class="table table-bordered">
  <thead>
    <tr>
      <th>ID</th>
      <th>Blood Pressure</th>
      <th>Temperature</th>
      <th>Weight</th>
      <th>Doctor</th>
      <th>Patient</th>
      <th>Payment Status</th>
      <th>Token Status</th>
      <th>Actions</th>
    </tr>
  </thead>
  <tbody>
    <% @tokens.each do |token| %>
      <tr>
        <td><%= token.id %></td>
        <td><%= token.Blood_pressure %> mmHg</td>
        <td><%= token.Temperature %> °F</td>
        <td><%= token.Weight %> kg</td>
        <td>
          <a href="<%= doctor_path(token.doctor.id) %>">
            <%= token.doctor_id %>#<%= token.doctor.Name %>
          </a>
        </td>
        <td>
          <a href="<%= patient_path(token.patient.id) %>">
            <%= token.patient_id %>#<%= token.patient.Name %>
          </a>
        </td>
        <td>
          <% if token.payment.present? %>
            <span class="badge <%= status_label_class(token.payment.status)  if token.payment.present?%>">
             <p>paid</p>
              
              <%else%>

              <strong class="lead">Padding</strong>
            </span>
          <%end%>
        </td>
        <td>
          <% if token.payment.present? %>
            <%=token.payment.payment_type%>
          <%end%>
      
        </td>
        <td>
          <% case token.status %>
          <% when "pending" %>
            <span style="color: orange;">Pending</span>
          <% when "completed" %>
            <span style="color: green;">Completed</span>
          <% when "canceled" %>
            <span style="color: red;">Canceled</span>
          <% else %>
            Unknown
          <% end %>
        </td>
        
        <td>
     
<div class="dropdown">
  <button class="dropbtn">Actions</button>
  <div class="dropdown-content">
    <% if current_user.userable_type == "Reception" || current_user.userable_type == "Patient" || current_user.userable_type == "Admin" %>
      <%= link_to "Make Payment", new_payment_path(token_id: token.id), class: "btn btn-success btn-sm" %>
    <% end %>

    <% if current_user.userable_type == "Doctor" %>
      <%= link_to "Edit", edit_token_path(token), class: 'dropdwon-item btn-primary' %>
      <%= link_to 'Show', token_path(token), class: 'dropdwon-item btn-info' %>
      <%= link_to "Prescriptions", new_token_prescription_path(token.id), class: 'dropdwon-item btn-primary' %>
    <% elsif current_user.userable_type == "Patient" || current_user.userable_type == "Reception" %>
      <%= link_to "Edit", edit_token_path(token), class: 'dropdwon-item btn-primary' %>
      <%= link_to "Print", token_path(token, format: :pdf), class: 'dropdwon-item btn-primary' %>
      <%= button_to 'Delete', token_path(token), method: :delete, data: { turbo_confirm: 'Are you sure?' }, class: 'dropdwon-item btn-danger btn-lg' %>
      <%= link_to 'Show', token_path(token), class: 'dropdwon-item btn-primary' %>
    <% end %>
  </div>
</div>


        </td>
      </tr>
    <% end %>
  </tbody>
</table>


    </div>

    </div>
    <style>
      .dropdown{
        position: relative;
        display: inline-block;
      }
      .dropbtn{
        background-color: green;
        color: white;
        padding: 16px;
        font-size: 16px;
        border: none;
      }


      .dropdown-content {
          display: none;
          position: absolute;
          background-color: #f1f1f1;
          min-width: 100px;
          box-shadow: 0px 8px 16px 0px rgba(0, 0, 0, 0.2);
          z-index: 1;
      }

      .dropdown-content a {
          color: black;
          padding: 12px 16px;
          text-decoration: none;
          display: block;
      }

      .dropdown-content a:hover {
          background-color: #ddd;
      }

      .dropdown:hover .dropdown-content {
          display: block;
      }

      .dropdown:hover .dropbtn {
          background-color: #3e8e41;
      }


        .abc {
            padding: 34px;
        }

        .search_bar {
            position: relative;
            left: 500px;
            top: 10px;
        }

        .content-body {
            margin-left: 150px;
        }
       .lead{
        background-color:green;
        color: white;
             
       }
    </style>
