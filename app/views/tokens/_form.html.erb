<%= form_with model: @token do |form| %>
  <div class="content-body">
    <div class="row">
      <div class="col-lg-5">
        <div class="form-group">
          <%= form.label :Blood_pressure, class: 'mb-3' %>
          <%= form.text_field :Blood_pressure, class: 'form-control form-control-lg' %>
        </div>
      </div>
      <div class="col-lg-5">
        <div class="form-group">
          <%= form.label :Temperature, class: 'mb-3' %>
          <%= form.text_field :Temperature, class: 'form-control form-control-lg' %>
        </div>
      </div>
      <div class="col-lg-5">
        <div class="form-group">
          <%= form.label :Weight, class: 'mb-3' %>
          <%= form.text_field :Weight, class: 'form-control form-control-lg' %>
        </div>
      </div>
<% if current_user.userable_type == "Reception" %>
  <div class="col-lg-5">
    <div class="form-group">
      <%= form.label :doctor_id, "Select Doctor", class: 'mb-3' %>
      <%= form.select :doctor_id,
            options_from_collection_for_select(Doctor.all, :id, ->(d) { "#{d.Name} - #{d.Specialization}" }, form.object.doctor_id),
            { prompt: "Choose a doctor" },
            class: "form-control form-control-lg" %>
    </div>
  </div>

<% else %>
  <div class="form-group">
    <%= label_tag :doctor_name, "Doctor" %>
    <%= text_field_tag :doctor_name, @doctor&.Name, class: "form-control", readonly: true %>
  </div>

  <% if @doctor.present? %>
    <%= form.hidden_field :doctor_id, value: @doctor.id %>
  <% end %>
<% end %>

<% if current_user.userable_type == "Patient" %>
  <%= form.hidden_field :patient_id, value: current_user.userable.id %>

<% elsif ["Reception", "Admin"].include?(current_user.userable_type) %>
  <div class="col-lg-5">
    <div class="form-group">
      <%= form.label :patient_id, "Select Patient", class: 'mb-3' %>
      <%= form.select :patient_id,
            options_from_collection_for_select(Patient.all, :id, ->(p) { "#{p.id} - #{p.Name}" }, form.object.patient_id),
            { prompt: "Choose a patient" },
            class: "form-control form-control-lg" %>
    </div>
  </div>
<% end %>

<div class="col-lg-5 mt-3">
  <%= form.submit "Create Token", class: 'btn btn-primary btn-lg' %>
  <%= link_to 'Back to Token', tokens_path, class: 'btn btn-secondary btn-lg' %>
</div>

<% end %>
<style type="text/css">
    .content-body {
        margin-left: 120px;
    }
</style>